<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/editNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nombre" />

        <!--
            Código de barra: se puede escribir a mano o escanear con el
            botón de al lado (usa el Code Scanner de Google Play Services,
            no hace falta pedir permiso de cámara). Al escanear, solo se
            completa este campo con el valor leído; no autocompleta
            nombre/marca (eso implicaría integrar una base de datos externa
            de códigos, fuera de alcance por ahora).
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/editCodigoBarra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_codigo_barra"
                android:inputType="text" />

            <Button
                android:id="@+id/botonEscanearCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/boton_escanear_codigo" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_categoria"
            android:layout_marginTop="16dp" />
        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_marca"
            android:layout_marginTop="12dp" />
        <Spinner
            android:id="@+id/spinnerMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_proveedor"
            android:layout_marginTop="12dp" />
        <Spinner
            android:id="@+id/spinnerProveedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editPrecioUnitario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_precio_unitario"
            android:inputType="numberDecimal"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/editPorcentajeGanancia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_porcentaje_ganancia"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/editCantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cantidad"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/botonGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boton_guardar"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
